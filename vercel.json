{
  "framework": "nextjs",
  "installCommand": "cd experience && npm install --include=dev",
  "buildCommand": "cd experience && npm run build",
  "outputDirectory": "experience/.next",
  "crons": [
    {
      "path": "/api/cron/ops",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/publish-scheduled",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/score-predictions",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/reader-digest",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/telegram-channel",
      "schedule": "0 9 * * *"
    }
  ]
}
