    {
      "parameters": {
        "mode": "append"
      },
      "id": "a1b2c3d4-1111-4000-8000-000000000005",
      "name": "Unisci feed",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [520, 300]
    },
    {
      "parameters": {
        "jsCode": "const maxAgeHours = 8;\nconst now = Date.now();\n\nconst items = $input.all()\n  .map((item) => item.json)\n  .filter((entry) => {\n    const pub = new Date(entry.pubDate || entry.isoDate || 0).getTime();\n    if (!Number.isFinite(pub)) return true;\n    return now - pub <= maxAgeHours * 60 * 60 * 1000;\n  })\n  .slice(0, 6)\n  .map((entry) => ({\n    json: {\n      source_name: entry.creator || entry['dc:creator'] || 'RSS',\n      title: entry.title || '',\n      link: entry.link || entry.guid || '',\n      pubDate: entry.pubDate || entry.isoDate || '',\n      contentSnippet: entry.contentSnippet || entry.summary || entry.description || '',\n      content: entry.content || entry['content:encoded'] || entry.description || '',\n      cover_image_url: entry.enclosure?.url || entry.image?.url || entry.mediaContent?.url || '',\n    },\n  }));\n\nreturn items.length ? items : [];"
      },
      "id": "a1b2c3d4-1111-4000-8000-000000000006",
      "name": "Filtra recenti",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [760, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "a1b2c3d4-1111-4000-8000-000000000007",
      "name": "Uno alla volta",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.GROQ_API_KEY}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"temperature\": 0.75,\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Sei un redattore senior di BianconeriHub, magazine digitale sulla Juventus. Scrivi in italiano con tono editoriale umano, appassionato ma sobrio. Non copiare: riscrivi dai fatti. Non inventare nomi, cifre o dichiarazioni non presenti nella fonte. Evita frasi da AI. Rispondi SOLO con JSON valido.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Fonte: {{ $json.source_name }}\\nTitolo: {{ $json.title }}\\nLink: {{ $json.link }}\\nData: {{ $json.pubDate }}\\nTesto:\\n{{ $json.contentSnippet || $json.content }}\\n\\nRiscrivi per BianconeriHub. JSON richiesto:\\n{\\\"title\\\":\\\"\\\",\\\"slug\\\":\\\"\\\",\\\"excerpt\\\":\\\"\\\",\\\"content\\\":\\\"HTML con p e h2\\\",\\\"category_slug\\\":\\\"mercato|calcio|formazione|champions|serie-a|interviste\\\",\\\"tags\\\":[\\\"\\\"],\\\"meta_title\\\":\\\"\\\",\\\"meta_description\\\":\\\"\\\"}\"\n    }\n  ]\n}"
      },
      "id": "a1b2c3d4-1111-4000-8000-000000000008",
      "name": "Groq — Riscrittura umana",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1240, 300]
    },
    {
      "parameters": {
        "jsCode": "const source = $('Uno alla volta').item.json;\nconst groq = $input.first().json;\nconst raw = groq?.choices?.[0]?.message?.content || '{}';\n\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch (error) {\n  throw new Error('Groq non ha restituito JSON valido: ' + raw.slice(0, 240));\n}\n\nreturn [{\n  json: {\n    title: parsed.title,\n    slug: parsed.slug,\n    excerpt: parsed.excerpt,\n    content: parsed.content,\n    category_slug: parsed.category_slug,\n    tags: parsed.tags || [],\n    meta_title: parsed.meta_title || parsed.title,\n    meta_description: parsed.meta_description || parsed.excerpt,\n    status: 'published',\n    source_url: source.link,\n    cover_image_url: source.cover_image_url || '',\n  },\n}];"
      },
      "id": "a1b2c3d4-1111-4000-8000-000000000009",
